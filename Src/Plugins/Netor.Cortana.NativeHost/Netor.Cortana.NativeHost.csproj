<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BrandNativeHostAssemblyName Condition="'$(BrandNativeHostAssemblyName)' == ''">Madorin.NativeHost</BrandNativeHostAssemblyName>
    <BrandNativeHostIcon Condition="'$(BrandNativeHostIcon)' == ''">brand.ico</BrandNativeHostIcon>
    <AssemblyName>$(BrandNativeHostAssemblyName)</AssemblyName>
    <ApplicationIcon>$(BrandNativeHostIcon)</ApplicationIcon>

    <!-- AOT 单文件发布 -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(BrandNativeHostIcon)" />
  </ItemGroup>

</Project>
