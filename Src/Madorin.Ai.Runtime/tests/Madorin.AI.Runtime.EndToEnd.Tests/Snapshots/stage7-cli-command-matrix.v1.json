  "invalidInvocations": [
    {
      "args": ["run", "--input", "hello", "--input-file", "input.txt"],
      "message": "--input and --input-file cannot be used together."
    },
    {
      "args": ["run", "--output-file", "out.txt"],
      "message": "--output-file requires --input or --input-file."
    },
    {
      "args": ["run", "--json"],
      "message": "JSON, JSONL, and --no-stream require --input or --input-file."
    },
    {
      "args": ["run", "--input", "hello", "--json", "--output-format", "text"],
      "message": "--json cannot be combined with a non-JSON --output-format value."
    },
    {
      "args": ["serve"],
      "message": "--workspace is required."
    },
    {
      "args": ["doctor", "--yes"],
      "message": "--yes requires --fix."
    },
    {
      "args": ["storage", "gc", "--dry-run", "--confirm"],
      "message": "--dry-run and --confirm cannot be used together."
    },
    {
      "args": ["session", "delete", "session-1"],
      "message": "Session deletion requires --confirm."
    },
    {
      "args": ["ctl", "credential", "update"],
      "message": "--run, --provider, and --api-key-env are required"
    }
  ],
