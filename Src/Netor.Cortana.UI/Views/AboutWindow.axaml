<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Netor.Cortana.UI.Views.AboutWindow"
        x:CompileBindings="True"
        Title="关于软件"
        Width="420" Height="260"
        MinWidth="420" MinHeight="260"
        MaxWidth="420" MaxHeight="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}">

	<Window.Styles>
		<Style Selector="Button.titlebar-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource SubtextBrush}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="MinWidth" Value="26" />
			<Setter Property="MinHeight" Value="24" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Surface0Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TextBrush}" />
		</Style>
	</Window.Styles>

	<Panel Background="{StaticResource BaseBrush}">
		<Border>
			<Grid RowDefinitions="*,Auto" Margin="24,22,24,18">
				<StackPanel Grid.Row="0" Spacing="14">
					<StackPanel Orientation="Horizontal" Spacing="14">
						<Image x:Name="LogoImage"
						       Width="48"
						       Height="48" />
						<StackPanel VerticalAlignment="Center" Spacing="4">
							<TextBlock x:Name="AppNameText"
							           Foreground="{StaticResource TextBrush}"
							           FontSize="20"
							           FontWeight="SemiBold" />
							<TextBlock x:Name="VersionText"
							           Foreground="{StaticResource AccentBrush}"
							           FontSize="12" />
						</StackPanel>
					</StackPanel>

					<Border Background="{StaticResource Surface0Brush}"
					        BorderBrush="{StaticResource Surface1Brush}"
					        BorderThickness="1"
					        CornerRadius="4"
					        Padding="12,10">
						<StackPanel Spacing="6">
							<TextBlock x:Name="SubtitleText"
							           Foreground="{StaticResource TextBrush}"
							           FontSize="13"
							           FontWeight="SemiBold" />
							<TextBlock x:Name="WorkspaceText"
							           Foreground="{StaticResource SubtextBrush}"
							           FontSize="12"
							           TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</StackPanel>

				<Button Grid.Row="1"
				        Classes="titlebar-btn"
				        HorizontalAlignment="Right"
				        MinWidth="72"
				        Content="确定"
				        Click="OnCloseClick" />
			</Grid>
		</Border>
	</Panel>
</Window>
