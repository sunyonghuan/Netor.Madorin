<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Netor.Cortana.UI.Controls.Meeting.MeetingHistoryPanel"
             x:CompileBindings="False"
             Background="#1e1e1e">

    <UserControl.Styles>
        <Style Selector="Border.meeting-history-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.meeting-history-item:pointerover">
            <Setter Property="Background" Value="#252526" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#1e1e1e"
                Padding="8,6"
                BorderBrush="#252526"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="会议记录"
                           Foreground="#cccccc"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="titlebar-btn"
                        ToolTip.Tip="刷新"
                        Click="OnRefreshClick">
                    <Image Source="/Assets/refresh.png"
                           Width="14"
                           Height="14" />
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#1e1e1e"
                Padding="8,4"
                BorderBrush="#252526"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="搜索会议主题..."
                     Background="#252526"
                     Foreground="#cccccc"
                     BorderBrush="#3c3c3c"
                     BorderThickness="1"
                     CornerRadius="3"
                     Padding="8,4"
                     FontSize="12"
                     TextChanged="OnSearchTextChanged" />
        </Border>

        <TextBlock x:Name="EmptyText"
                   DockPanel.Dock="Bottom"
                   Text="暂无会议记录"
                   FontSize="12"
                   Foreground="#6f6f6f"
                   TextAlignment="Center"
                   Margin="0,8,0,10"
                   IsVisible="False" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <ItemsControl x:Name="MeetingItems" Padding="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
