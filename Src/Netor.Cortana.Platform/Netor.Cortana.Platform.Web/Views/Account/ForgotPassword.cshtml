@model Netor.Cortana.Platform.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "忘记密码";
}

<div class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">ACCOUNT</span>
        <h1>找回账号密码</h1>
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Account" class="form-label"></label>
                <input asp-for="Account" class="form-control" autocomplete="username" />
                <span asp-validation-for="Account" class="text-danger small"></span>
            </div>
            <button class="btn btn-madorin-primary w-100" type="submit">继续</button>
        </form>
        <p class="muted-line mt-3 mb-0">想起密码了？<a asp-action="Login">返回登录</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
