@model Netor.Cortana.Platform.Admin.Models.Creators.CreatorRelatedViewModel
@using Netor.Cortana.Platform.Entitys.Enums
@{
    ViewData["Title"] = "创作者结算记录";
}

<div class="admin-drawer-page">
    <section class="admin-card admin-filter-card">
        <div class="admin-card-body">
            <form id="creatorSettlementFilter" class="layui-form layui-form-pane" lay-filter="creatorSettlementFilter">
                <input type="hidden" name="accountId" value="@Model.AccountId" />
                <div class="admin-filter-grid">
                    <div class="layui-form-item admin-filter-span-2">
                        <label class="layui-form-label">关键词</label>
                        <div class="layui-input-block">
                            <input class="layui-input" name="keyword" placeholder="资源/订单/币种/备注" />
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">状态</label>
                        <div class="layui-input-block">
                            <select name="status">
                                <option value="">全部</option>
                                @foreach (var option in Enum.GetValues<SettlementStatus>())
                                {
                                    <option value="@((int)option)">@GetSettlementStatusName(option)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">净额最小</label>
                        <div class="layui-input-block">
                            <input class="layui-input" name="netMin" type="number" step="0.01" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">净额最大</label>
                        <div class="layui-input-block">
                            <input class="layui-input" name="netMax" type="number" step="0.01" placeholder="9999.00" />
                        </div>
                    </div>
                    <div class="layui-form-item admin-filter-submit">
                        <button class="layui-btn layui-btn-normal" lay-submit lay-filter="creatorSettlementSearch">查询</button>
                        <button class="layui-btn layui-btn-primary" type="button" data-creator-settlement-filter-reset>重置</button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="admin-card admin-layui-table-card">
        <div class="admin-card-body">
            <table id="creatorSettlementTable" lay-filter="creatorSettlementTable"></table>
        </div>
    </section>
</div>

<script type="text/html" id="creatorSettlementMoneyTpl">
    <div class="admin-text-strong">{{ d.netAmount }} {{ d.currency }}</div>
    <div class="admin-text-muted">总额 {{ d.grossAmount }} / 费用 {{ d.platformFeeAmount }}</div>
</script>

<script type="text/html" id="creatorSettlementStatusTpl">
    <span class="admin-badge {{ d.statusBadgeClass }}">{{ d.statusName }}</span>
</script>

@section Scripts {
    <script>
        layui.use(["form"], function () {
            const form = layui.form;
            const filterSelector = "#creatorSettlementFilter";
            const tableId = "creatorSettlementTable";

            window.adminTable.render({
                elem: "#creatorSettlementTable",
                id: tableId,
                url: "@Url.Action("SettlementsTableData", "Creators")",
                where: window.adminFilter.collect(filterSelector),
                cols: [[
                    { field: "assetName", title: "资源", minWidth: 180, sort: true },
                    { field: "orderNo", title: "订单", minWidth: 180, sort: true },
                    { field: "netAmount", title: "金额", width: 190, templet: "#creatorSettlementMoneyTpl", sort: true },
                    { field: "statusName", title: "状态", width: 110, templet: "#creatorSettlementStatusTpl", sort: true },
                    { field: "settledAtText", title: "结算时间", width: 170, sort: true },
                    { field: "timeStamp", title: "创建标记", width: 150, sort: true }
                ]]
            });

            form.on("submit(creatorSettlementSearch)", function () {
                window.adminTable.reload(tableId, window.adminFilter.collect(filterSelector));
                return false;
            });

            document.querySelector("[data-creator-settlement-filter-reset]")?.addEventListener("click", function () {
                window.adminFilter.reset(tableId, filterSelector);
            });
        });
    </script>
}

@functions {
    private static string GetSettlementStatusName(SettlementStatus status) => status switch
    {
        SettlementStatus.Pending => "待结算",
        SettlementStatus.Settled => "已结算",
        SettlementStatus.Frozen => "已冻结",
        SettlementStatus.Rejected => "已驳回",
        _ => status.ToString()
    };
}
