@model Netor.Cortana.Platform.Admin.Models.Accounts.AccountPasswordViewModel
@{
    ViewData["Title"] = "重置用户密码";
    var mode = Context.Request.Query["mode"].ToString();
    var isDrawer = string.Equals(mode, "drawer", StringComparison.OrdinalIgnoreCase);
}

<div class="admin-drawer-page">
    <section class="admin-card admin-form-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-title">重置用户密码</h2>
                <div class="admin-inline-stat">@Model.LoginUserName</div>
            </div>
            @if (isDrawer)
            {
                <button class="layui-btn layui-btn-primary layui-btn-sm" type="button" data-drawer-close>关闭</button>
            }
            else
            {
                <a class="layui-btn layui-btn-primary layui-btn-sm" asp-action="Details" asp-route-id="@Model.Id" asp-route-mode="drawer" data-admin-drawer="right" data-title="用户详情" data-width="820px">返回详情</a>
            }
        </div>
        <div class="admin-card-body">
            <form method="post" class="layui-form layui-form-pane" data-admin-confirm-submit="提交后会立即覆盖用户密码，确定继续吗？" data-admin-ajax-form="@isDrawer.ToString().ToLowerInvariant()" data-admin-table-id="accountTable" data-admin-success-message="用户密码已重置。">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="LoginUserName" type="hidden" />
                <input name="mode" type="hidden" value="@mode" />
                <div asp-validation-summary="ModelOnly" class="layui-elem-quote layui-quote-nm"></div>

                <div class="layui-form-item">
                    <label asp-for="NewPassword" class="layui-form-label"></label>
                    <div class="layui-input-block">
                        <input asp-for="NewPassword" class="layui-input" type="password" autocomplete="new-password" lay-verify="required" />
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label asp-for="NewSafePassword" class="layui-form-label"></label>
                    <div class="layui-input-block">
                        <input asp-for="NewSafePassword" class="layui-input" type="password" autocomplete="new-password" placeholder="留空则不修改" />
                        <span asp-validation-for="NewSafePassword" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="layui-elem-quote layui-quote-nm">提交前请确认已经完成身份核验。</div>

                <div class="admin-drawer-footer">
                    <button class="layui-btn layui-btn-danger" type="submit" lay-submit lay-filter="adminAjaxSubmit">确认重置</button>
                    @if (isDrawer)
                    {
                        <button class="layui-btn layui-btn-primary" type="button" data-drawer-close>取消</button>
                    }
                    else
                    {
                        <a class="layui-btn layui-btn-primary" asp-action="Details" asp-route-id="@Model.Id" asp-route-mode="drawer" data-admin-drawer="right" data-title="用户详情" data-width="820px">取消</a>
                    }
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
