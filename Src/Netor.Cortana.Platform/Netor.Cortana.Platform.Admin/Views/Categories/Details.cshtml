@model Netor.Cortana.Platform.Admin.Models.Categories.CategoryDetailViewModel
@{
    ViewData["Title"] = "分类详情";
    var isDrawer = string.Equals(Context.Request.Query["mode"], "drawer", StringComparison.OrdinalIgnoreCase);
}

<div class="@(isDrawer ? "admin-drawer-page" : string.Empty)">
    <section class="admin-card">
        <div class="admin-card-header">
            <div>
                <h2 class="admin-card-title">@Model.Name</h2>
                <div class="admin-inline-stat">@Model.Slug</div>
            </div>
            @if (isDrawer)
            {
                <button class="layui-btn layui-btn-primary layui-btn-sm" type="button" data-drawer-close>关闭</button>
            }
            else
            {
                <a class="layui-btn layui-btn-primary layui-btn-sm" asp-action="Index">返回列表</a>
            }
        </div>
        <div class="admin-card-body">
            <div class="asset-detail-grid">
                <div>
                    <div class="detail-label">显示状态</div>
                    <span class="admin-badge @(Model.IsVisible ? "admin-badge-success" : "admin-badge-muted")">@(Model.IsVisible ? "显示" : "隐藏")</span>
                </div>
                <div>
                    <div class="detail-label">排序</div>
                    <strong>@Model.SortOrder</strong>
                </div>
                <div>
                    <div class="detail-label">资源数</div>
                    <strong>@Model.AssetCount</strong>
                </div>
                <div>
                    <div class="detail-label">已发布资源</div>
                    <strong>@Model.PublishedAssetCount</strong>
                </div>
            </div>

            <hr />

            <h3 class="admin-section-title">分类描述</h3>
            <p class="admin-text-muted">@Model.Description</p>
        </div>
    </section>

    <section class="admin-card">
        <div class="admin-card-header">
            <h2 class="admin-card-title">关联资源</h2>
            <span class="admin-inline-stat">最多显示 20 条</span>
        </div>
        <div class="admin-card-body">
            <table class="layui-table admin-table">
                <thead>
                    <tr>
                        <th>资源</th>
                        <th>类型</th>
                        <th>状态</th>
                        <th>下载</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Assets.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="admin-empty-cell">暂无关联资源。</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Assets)
                        {
                            <tr>
                                <td>
                                    <div class="admin-text-strong">@item.Name</div>
                                    <div class="admin-text-muted">@item.Slug</div>
                                </td>
                                <td>@item.TypeName</td>
                                <td>@item.StatusName</td>
                                <td>@item.DownloadCount</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
