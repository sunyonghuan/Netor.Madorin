@model Netor.Cortana.Platform.Admin.Models.Docs.DocCategoryEditViewModel
@{
    ViewData["Title"] = "新增文档分类";
}

<section class="admin-card admin-form-card">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">新增文档分类</h2>
            <div class="text-secondary">创建官网文档中心的分类入口</div>
        </div>
        <a class="layui-btn layui-btn-primary layui-btn-sm" asp-action="Categories">返回分类</a>
    </div>
    <div class="admin-card-body">
        <partial name="_CategoryForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
